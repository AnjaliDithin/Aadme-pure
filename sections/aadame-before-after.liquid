{% comment %}
  Aadame Pure Clinical Before/After Interactive Split-Screen Slider
  Features touch/mouse draggable comparison handle + clinical trial metrics
{% endcomment %}
<div class="aadame-ba-section">
  <div class="page-width">
    <div class="aadame-ba-header">
      <span class="aadame-ba-tag">✦ Clinical Transformation ✦</span>
      <h2 class="aadame-ba-title">Real Results. Pure Radiance.</h2>
      <p class="aadame-ba-desc">
        Drag the interactive slider to see the transformative power of Aadame Pure’s peptide and barrier-restoring botanicals over 14 days of ritual use.
      </p>
    </div>

    <div class="aadame-ba-container">
      <!-- After Image (Full width underneath) -->
      <img
        src="{{ 'routine-glass-skin.jpg' | asset_url }}"
        alt="Day 14: Radiant Luminous Glass Skin After Aadame Pure Ritual"
        class="aadame-ba-img-after"
        loading="lazy"
        width="860"
        height="520"
      >

      <!-- Before Image (Clipped overlay) -->
      <div class="aadame-ba-img-before-wrapper">
        <img
          src="{{ 'texture-botanical-dew.jpg' | asset_url }}"
          alt="Day 1: Dehydrated & Dull Skin Prior to Aadame Pure Ritual"
          class="aadame-ba-img-before"
          loading="lazy"
          width="860"
          height="520"
        >
      </div>

      <!-- Draggable Split Handle -->
      <div class="aadame-ba-handle" aria-label="Drag to compare before and after">
        <div class="aadame-ba-handle-btn">
          <span>⬌</span>
        </div>
      </div>

      <!-- Labels -->
      <span class="aadame-ba-label-before">Day 1: Baseline</span>
      <span class="aadame-ba-label-after">Day 14: Glass Skin Glow</span>
    </div>

    <!-- Clinical Proof Metrics -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; max-width: 860px; margin: 3.2rem auto 0; text-align: center;">
      <div style="background: #FFFFFF; padding: 2rem; border-radius: 16px; border: 1px solid rgba(154, 107, 72, 0.15); box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 3.6rem; font-weight: 700; color: #9A6B48; line-height: 1;">+94%</div>
        <p style="margin-top: 0.8rem; font-size: 1.25rem; font-weight: 600; color: #1C1917;">Immediate Hydration Boost</p>
        <span style="font-size: 1.1rem; color: #78716C;">Measured via Corneometer after 1 use</span>
      </div>

      <div style="background: #FFFFFF; padding: 2rem; border-radius: 16px; border: 1px solid rgba(154, 107, 72, 0.15); box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 3.6rem; font-weight: 700; color: #9A6B48; line-height: 1;">88%</div>
        <p style="margin-top: 0.8rem; font-size: 1.25rem; font-weight: 600; color: #1C1917;">Calmed Redness & Irritation</p>
        <span style="font-size: 1.1rem; color: #78716C;">Clinical consumer study across 60 subjects</span>
      </div>

      <div style="background: #FFFFFF; padding: 2rem; border-radius: 16px; border: 1px solid rgba(154, 107, 72, 0.15); box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
        <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 3.6rem; font-weight: 700; color: #9A6B48; line-height: 1;">98%</div>
        <p style="margin-top: 0.8rem; font-size: 1.25rem; font-weight: 600; color: #1C1917;">Visible Luminous Glass-Skin Radiance</p>
        <span style="font-size: 1.1rem; color: #78716C;">Users confirmed lasting dewy luminosity</span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Before / After Slider",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "Before / After Slider"
    }
  ]
}
{% endschema %}
