    "faq-collapsible": {
      "type": "collapsible-content",
      "blocks": {
        "faq-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which products should I start with for my skin type?",
            "icon": "check_mark",
            "row_content": "<p>Our Dew Drops Peptide Serum and Ceramide Barrier Recovery Cream form the foundational duo suitable for every skin type. For extra dewy hydration or oily skin seeking lightweight moisture, add the Gentle Jelly Cleanser and Rose Dew Facial Mist.</p>"
          }
        },
        "faq-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are Aadame Pure formulas safe for sensitive or acne-prone skin?",
            "icon": "leaf",
            "row_content": "<p>Yes. Every single Aadame Pure formula is non-comedogenic (won't clog pores), pH-balanced (5.0–5.5), and clinically evaluated by independent dermatologists to soothe irritation and redness.</p>"
          }
        },
        "faq-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Are your products cruelty-free, vegan, and sustainably made?",
            "icon": "recycle",
            "row_content": "<p>Proudly yes! We are 100% Leaping Bunny certified cruelty-free and vegan. All packaging is crafted from recyclable frosted glass and post-consumer recycled paper printed with natural vegetable inks.</p>"
          }
        },
        "faq-4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is the 30-Day Radiant Skin Guarantee?",
            "icon": "heart",
            "row_content": "<p>We want you to feel complete confidence in your skincare journey. If you aren't completely in love with your radiant results after 30 days, simply contact our care team for a full, hassle-free refund.</p>"
          }
        }
      },
