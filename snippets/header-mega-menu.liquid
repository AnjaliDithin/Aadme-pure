{% doc %}
  Renders the header menu in the mega menu style.

  @param {object} [section] - The current header section context, supplied implicitly when rendered from that section and used for menu settings.

  @example
  {% render 'header-mega-menu' %}
{% enddoc %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      {%- liquid
        assign is_catalog = false
        assign link_title_down = link.title | downcase
        if link.handle == 'catalog' or link.handle == 'all-products' or link_title_down contains 'catalog' or link_title_down contains 'shop' or link_title_down contains 'products'
          assign is_catalog = true
        endif
      -%}
      <li>
        {%- if link.links != blank or is_catalog -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="mega-menu__wrapper page-width">
                  <div class="mega-menu__nav-columns">
                    <p class="mega-menu__column-heading">Shop By Ritual</p>
                    <ul class="mega-menu__list list-unstyled" role="list">
                      {%- if link.links != blank -%}
                        {%- for childlink in link.links -%}
                          <li>
                            <a
                              id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ childlink.title | escape }}
                            </a>
                            {%- if childlink.links != blank -%}
                              <ul class="list-unstyled" role="list">
                                {%- for grandchildlink in childlink.links -%}
                                  <li>
                                    <a
                                      id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                      href="{{ grandchildlink.url }}"
                                      class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                      {% if grandchildlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{ grandchildlink.title | escape }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      {%- else -%}
                        <li>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-menu__link mega-menu__link--level-2 link">
                            All Skincare Rituals
                          </a>
                        </li>
                        <li>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-menu__link link">
                            Hydrating Serums & Actives
                          </a>
                        </li>
                        <li>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-menu__link link">
                            Barrier & Recovery Creams
                          </a>
                        </li>
                        <li>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-menu__link link">
                            Gentle Botanical Jelly Cleansers
                          </a>
                        </li>
                        <li>
                          <a href="{{ routes.all_products_collection_url }}" class="mega-menu__link link">
                            Dewy Facial Mists & Essences
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  </div>

                  <div class="mega-menu__featured-cards">
                    <a href="{{ routes.all_products_collection_url }}" class="mega-menu__card">
                      <div class="mega-menu__card-media">
                        <img
                          src="{{ 'product-serum.jpg' | asset_url }}"
                          alt="Dew Drops Peptide Serum"
                          width="240"
                          height="240"
                          loading="lazy"
                        >
                        <span class="mega-menu__card-badge">Bestseller</span>
                      </div>
                      <div class="mega-menu__card-info">
                        <span class="mega-menu__card-title">Dew Drops Peptide Serum</span>
                        <span class="mega-menu__card-price">$48.00</span>
                      </div>
                    </a>

                    <a href="{{ routes.all_products_collection_url }}" class="mega-menu__card">
                      <div class="mega-menu__card-media">
                        <img
                          src="{{ 'product-cream.jpg' | asset_url }}"
                          alt="Ceramide Barrier Recovery Cream"
                          width="240"
                          height="240"
                          loading="lazy"
                        >
                        <span class="mega-menu__card-badge">Award Winner</span>
                      </div>
                      <div class="mega-menu__card-info">
                        <span class="mega-menu__card-title">Ceramide Barrier Cream</span>
                        <span class="mega-menu__card-price">$54.00</span>
                      </div>
                    </a>

                    <a href="{{ routes.all_products_collection_url }}" class="mega-menu__card">
                      <div class="mega-menu__card-media">
                        <img
                          src="{{ 'routine-glass-skin.jpg' | asset_url }}"
                          alt="The 4-Step Glass Skin Ritual"
                          width="240"
                          height="240"
                          loading="lazy"
                        >
                        <span class="mega-menu__card-badge" style="background: #1C1917; color: #FAF8F5;">Save 20%</span>
                      </div>
                      <div class="mega-menu__card-info">
                        <span class="mega-menu__card-title">The Glass Skin Ritual</span>
                        <span class="mega-menu__card-price">$128.00</span>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
